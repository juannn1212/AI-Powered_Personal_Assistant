# Copia este archivo a .env (ignorado por git) y cambia los valores.
# Contraseña de PostgreSQL (solo se usa al crear el volumen por primera vez)
POSTGRES_PASSWORD=cambia-esto
# Clave para firmar los JWT. Genérala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
# Opcional: puerto local del backend si el 8000 está ocupado
# BACKEND_PORT=8000
